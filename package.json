{
  "name": "open-table-poker-teacher",
  "version": "0.1.0",
  "description": "A local-first decision teacher for Texas Hold'em, Contract Bridge, and Guandan.",
  "private": true,
  "license": "MIT",
  "author": "Lachlan Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lachlanchen/Poker.git"
  },
  "homepage": "https://github.com/lachlanchen/Poker#readme",
  "bugs": {
    "url": "https://github.com/lachlanchen/Poker/issues"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "contract-bridge",
    "guandan",
    "teaching"
  ],
  "packageManager": "npm@10.9.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8020 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 8020 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "@eslint/js": "9.32.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.2.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
